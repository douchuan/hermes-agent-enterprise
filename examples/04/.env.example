# Control Plane 环境变量
#
# 复制为 .env 并填入实际值。
# 本地开发：大多数变量有默认值，仅需设置 SESSION_SECRET（可选）。
# 生产环境：所有变量都必须设置，不得使用默认值。

# OIDC Provider 地址
# 本地 Dex：http://localhost:5556/dex
# 生产 Google：https://accounts.google.com
OIDC_ISSUER_URL=http://localhost:5556/dex

# OIDC 客户端 ID（在 Dex staticClients 或 Google Cloud Console 中注册）
OIDC_CLIENT_ID=hermes-control-plane

# OIDC 客户端密钥
# ⚠️ 本地开发默认值仅用于测试。生产环境必须更换。
OIDC_CLIENT_SECRET=not-a-real-secret-dev-only

# 回调地址（必须与 OIDC Provider 中注册的一致）
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Session 密钥
# ⚠️ 生产环境必须设置，不得使用默认值或随机生成。
# SESSION_SECRET=

# 监听端口
PORT=3000
